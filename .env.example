# Copien estas tres variables en benchmark-wk/.env.local y rellenen los valores.
# Las claves están en Supabase → Settings (el engranaje) → API Keys.
# El archivo .env.local es PRIVADO: no se comparte ni se sube a GitHub.

# La dirección: https:// + el código de su proyecto + .supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Clave pública (anon / publishable). Respeta las reglas de seguridad.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta (service_role / secret). Se salta las reglas de seguridad.
# Solo para el script de carga y la página /debug. Nunca en el navegador ni en la chat.
SUPABASE_SERVICE_ROLE_KEY=
